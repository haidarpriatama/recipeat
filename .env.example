# Copy this file to .env and fill in actual values.
# Use a hosted Postgres for team access (Supabase, ElephantSQL, Railway, etc.)
# Example connection string format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public


DATABASE_URL=postgresql://your_user:your_password@db-host.example.com:5432/your_database?schema=public

# If using Supabase, paste the connection string from Project > Settings > Database.
# Supabase requires SSL. Set DB_SSL=true if connecting to a hosted Supabase database.
DB_SSL=true


DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public"
AUTH_SECRET="your_nextauth_secret_key"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your_project_id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
