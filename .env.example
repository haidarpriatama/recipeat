# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Required: shared PostgreSQL/Supabase database used by the team.
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public"

# Required for Prisma migrations/introspection. Use the direct Supabase Postgres
# host instead of the pooler when possible.
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[HOST]:5432/[DATABASE]?schema=public"

# Required: generate with `openssl rand -base64 32` and share the same value across team devices.
AUTH_SECRET="your_nextauth_secret_key"

# Required: Supabase auth/client configuration.
NEXT_PUBLIC_SUPABASE_URL="https://your_project_id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Optional: only needed for scripts/server work that explicitly use the service role key.
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
