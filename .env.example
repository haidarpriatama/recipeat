# Copy this file to `.env` before running the app.
# Prisma uses `DATABASE_URL` for the app runtime.
# `DIRECT_URL` is for maintenance commands / migrations.

DATABASE_URL="postgresql://[USER]:[PASSWORD]@[POOLER_HOST]:6543/[DATABASE]?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[DIRECT_HOST]:5432/[DATABASE]"

# Set this to true if your Postgres provider requires SSL.
DB_SSL=true

AUTH_SECRET="your_nextauth_secret_key"

NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
