// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

// Generator client to create Prisma Client
generator client {
  provider = "prisma-client-js"  // Perbaikan pada provider
  output   = "../generated/prisma"
}

// Datasource configuration to connect to PostgreSQL
datasource db {
  provider = "postgresql"
}

// Enum Role untuk membedakan jenis peran pengguna
enum Role {
  USER
  ADMIN
}

// Enum RecipeStatus untuk membedakan status resep
enum RecipeStatus {
  PUBLISHED
  DRAFT
}

// Model User untuk menyimpan informasi pengguna
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Optional: OAuth users tidak punya password
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  favorites Favorite[]
  mealPlans MealPlan[]
  ratings   Rating[]
}

// Model Account untuk NextAuth OAuth providers
model Account {
  id                Int     @id @default(autoincrement())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Model Session untuk NextAuth sessions
model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId           String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Model VerificationToken untuk NextAuth email verification
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Model Recipe untuk menyimpan data resep
model Recipe {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  instructions String?  // Cara pembuatan resep
  imageUrl    String?
  cookTime    Int      // Waktu memasak dalam menit
  categoryId  Int
  protein     Int      @default(0)
  carbs       Int      @default(0)
  fats        Int      @default(0)
  status      RecipeStatus @default(PUBLISHED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category   @relation(fields: [categoryId], references: [id]) // Relasi ke kategori
  ingredients RecipeIngredient[] // Relasi ke RecipeIngredient
  favorites   Favorite[]         // Relasi ke Favorite
  mealPlans   MealPlanRecipe[]   // Relasi ke MealPlanRecipe
  ratings     Rating[]           // Relasi ke Rating

  // Indexes for explore page filter/sort performance
  // status+createdAt: covers default listing (PUBLISHED, order by newest)
  @@index([status, createdAt(sort: Desc)])
  // categoryId+status: covers category filter queries
  @@index([categoryId, status])
  // cookTime: covers serving-time range filter (<15, <30, <60, >90)
  @@index([cookTime])
  // TODO: For title/description full-text search, add a GIN trigram index
  // via a raw SQL migration (not expressible in Prisma schema):
  //   CREATE EXTENSION IF NOT EXISTS pg_trgm;
  //   CREATE INDEX CONCURRENTLY idx_recipe_title_trgm
  //     ON "Recipe" USING GIN (title gin_trgm_ops);
}

// Model Category untuk menyimpan kategori resep
model Category {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  recipes Recipe[] // Relasi ke tabel Recipe
}

// Model Ingredient untuk menyimpan daftar bahan unik
model Ingredient {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  recipes RecipeIngredient[]
}

// Model RecipeIngredient untuk detail bahan resep
model RecipeIngredient {
  id             Int      @id @default(autoincrement())
  recipeId       Int
  ingredientId   Int
  quantity       String

  recipe         Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id])

  // Indexes for ingredient filter join on explore page
  @@index([recipeId])
  @@index([ingredientId])
}

// Model Favorite untuk menyimpan resep favorit pengguna
model Favorite {
  userId   String
  recipeId Int
  savedAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])  // Relasi ke User
  recipe Recipe @relation(fields: [recipeId], references: [id]) // Relasi ke Recipe

  @@id([userId, recipeId])  // Primary key gabungan
}

// Model MealPlan untuk menyimpan rencana makan pengguna
model MealPlan {
  id        Int      @id @default(autoincrement())
  userId    String
  weekStart DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User             @relation(fields: [userId], references: [id])  // Relasi ke User
  recipes MealPlanRecipe[] // Relasi ke MealPlanRecipe
}

// Model MealPlanRecipe untuk menyimpan resep dalam rencana makan pada hari tertentu
model MealPlanRecipe {
  mealPlanId Int
  recipeId   Int
  dayOfWeek  String  // Menyimpan hari dalam minggu (Monday, Tuesday, dll.)
  mealType   String  @default("Lunch") // Breakfast, Lunch, Dinner

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id]) // Relasi ke MealPlan
  recipe   Recipe   @relation(fields: [recipeId], references: [id])   // Relasi ke Recipe

  @@id([mealPlanId, recipeId, dayOfWeek])  // Primary key gabungan
}

// Model Rating untuk menyimpan rating pengguna untuk resep
model Rating {
  id        Int      @id @default(autoincrement())
  userId    String
  recipeId  Int
  score     Int      // Nilai rating dari 1-5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId]) // Satu rating per user per recipe
}