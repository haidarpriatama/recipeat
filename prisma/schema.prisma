// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

// Generator client to create Prisma Client
generator client {
  provider = "prisma-client-js"  // Perbaikan pada provider
  output   = "../generated/prisma"
}

// Datasource configuration to connect to PostgreSQL
datasource db {
  provider = "postgresql"
}

// Enum Role untuk membedakan jenis peran pengguna
enum Role {
  USER
  ADMIN
}

// Model User untuk menyimpan informasi pengguna
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Optional: OAuth users tidak punya password
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  favorites Favorite[]
  mealPlans MealPlan[]
}

// Model Account untuk NextAuth OAuth providers
model Account {
  id                Int     @id @default(autoincrement())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Model Session untuk NextAuth sessions
model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId           String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Model VerificationToken untuk NextAuth email verification
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Model Recipe untuk menyimpan data resep
model Recipe {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  imageUrl    String?
  cookTime    Int      // Waktu memasak dalam menit
  rating      Float    @default(0)
  categoryId  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category   @relation(fields: [categoryId], references: [id]) // Relasi ke kategori
  ingredients RecipeIngredient[] // Relasi ke RecipeIngredient
  favorites   Favorite[]         // Relasi ke Favorite
  mealPlans   MealPlanRecipe[]   // Relasi ke MealPlanRecipe
}

// Model Category untuk menyimpan kategori resep
model Category {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  recipes Recipe[] // Relasi ke tabel Recipe
}

// Model Ingredient untuk bahan makanan yang digunakan dalam resep
model Ingredient {
  id      Int    @id @default(autoincrement())
  name    String @unique

  recipes RecipeIngredient[]  // Relasi ke RecipeIngredient
}

// Model RecipeIngredient untuk relasi many-to-many antara Recipe dan Ingredient
model RecipeIngredient {
  recipeId     Int
  ingredientId Int
  quantity     String   // Jumlah bahan yang digunakan, bisa diperbaiki jika diperlukan

  recipe     Recipe     @relation(fields: [recipeId], references: [id])  // Relasi ke Recipe
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])  // Relasi ke Ingredient

  @@id([recipeId, ingredientId]) // Primary key gabungan
}

// Model Favorite untuk menyimpan resep favorit pengguna
model Favorite {
  userId   String
  recipeId Int
  savedAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])  // Relasi ke User
  recipe Recipe @relation(fields: [recipeId], references: [id]) // Relasi ke Recipe

  @@id([userId, recipeId])  // Primary key gabungan
}

// Model MealPlan untuk menyimpan rencana makan pengguna
model MealPlan {
  id        Int      @id @default(autoincrement())
  userId    String
  weekStart DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User             @relation(fields: [userId], references: [id])  // Relasi ke User
  recipes MealPlanRecipe[] // Relasi ke MealPlanRecipe
}

// Model MealPlanRecipe untuk menyimpan resep dalam rencana makan pada hari tertentu
model MealPlanRecipe {
  mealPlanId Int
  recipeId   Int
  dayOfWeek  String  // Menyimpan hari dalam minggu (Monday, Tuesday, dll.)

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id]) // Relasi ke MealPlan
  recipe   Recipe   @relation(fields: [recipeId], references: [id])   // Relasi ke Recipe

  @@id([mealPlanId, recipeId, dayOfWeek])  // Primary key gabungan
}